// schema.prisma — Utensilferramenta Pistoiese S.p.A. (UFPtrade)
// PostgreSQL 16 + pgvector. Special indexes (tsvector GIN, vector HNSW) are
// created in the migration SQL because Prisma cannot emit the required
// operator class (vector_cosine_ops) for Unsupported column types.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector, pg_trgm]
}

// ═══════════════════════════════════════════════════════════════
// 1. USER & AUTH
// ═══════════════════════════════════════════════════════════════

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false) @map("email_verified")
  image         String?

  // Better Auth username plugin (Fase B — login senza email)
  username        String? @unique
  displayUsername String? @map("display_username")

  // Domain fields
  firstName String @map("first_name")
  lastName  String @map("last_name")
  role      String @default("AGENT") // AGENT | ADMIN
  status    String @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED

  // Admin plugin (Better Auth)
  banned     Boolean?  @default(false)
  banReason  String?   @map("ban_reason")
  banExpires DateTime? @map("ban_expires")

  // Relations
  sessions      Session[]
  accounts      Account[]
  conversations Conversation[]
  kitRequests   KitRequest[]   @relation("KitRequestAgent")
  activityLogs  ActivityLog[]
  settings      Settings[]
  stockImports  StockImport[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════
// BETTER AUTH — core tables (session / account / verification)
// ═══════════════════════════════════════════════════════════════

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent") @db.Text

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id         String @id @default(cuid())
  accountId  String @map("account_id")
  providerId String @map("provider_id")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ═══════════════════════════════════════════════════════════════
// 2. PRODUCT CATALOG
// ═══════════════════════════════════════════════════════════════

model ProductCategory {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String? @map("image_url")

  parentId String?           @map("parent_id")
  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryHierarchy")

  products     Product[]
  kitTemplates KitTemplate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id               String  @id @default(cuid())
  agbCode          String  @unique @map("agb_code")
  sku              String  @unique
  name             String
  description      String? @db.Text
  shortDescription String? @map("short_description") @db.Text

  basePrice       Decimal  @map("base_price") @db.Decimal(12, 2)
  discountedPrice Decimal? @map("discounted_price") @db.Decimal(12, 2)
  priceUnit       String   @default("EUR") @map("price_unit")

  stockQuantity Int     @default(0) @map("stock_quantity")
  isAvailable   Boolean @default(true) @map("is_available")

  categoryId String          @map("category_id")
  category   ProductCategory @relation(fields: [categoryId], references: [id])

  imageUrls    String[] @map("image_urls")
  datasheetUrl String?  @map("datasheet_url")

  specifications Json? @map("specifications")

  weightKg Decimal? @map("weight_kg") @db.Decimal(8, 3)
  lengthMm Int?     @map("length_mm")
  widthMm  Int?     @map("width_mm")
  heightMm Int?     @map("height_mm")

  // Pagina FISICA del listino PDF dove il codice è a prezzo (feature «visualizza nel listino»).
  listinoPage Int? @map("listino_page")

  // Search & AI. Indexes are created manually in the migration (GIN / HNSW).
  searchVector Unsupported("tsvector")?    @map("search_vector")
  embedding    Unsupported("vector(768)")? // gemini-embedding-001 @ 768 dims

  kitComponents        KitComponent[]
  conversationMessages Message[]      @relation("ReferencedProducts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([agbCode])
  @@index([sku])
  @@index([categoryId])
  @@index([isAvailable])
  @@map("products")
}

/// Foto prodotto estratta dal listino PDF (feature «immagini prodotto»). Tabella
/// separata da Product così i byte non finiscono nelle query di catalogo/dettaglio;
/// chiave = agbCode (una foto per codice). Popolata dallo script di estrazione ops.
model ProductImage {
  agbCode   String   @id @map("agb_code")
  data      Bytes
  mimeType  String   @map("mime_type")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("product_images")
}

// ═══════════════════════════════════════════════════════════════
// 3. KIT SYSTEM
// ═══════════════════════════════════════════════════════════════

enum KitRequestStatus {
  DRAFT
  PENDING_GENERATION
  GENERATING
  COMPLETED
  REVIEWED
  SENT_TO_CUSTOMER
  APPROVED
  REJECTED
}

enum WindowType {
  ANTA_RIBALTA
  ANTA_PROIETTANTE
  ANTA_BATTENTE
  SCORREVOLE_ALZANTE
  SCORREVOLE_TRASLANTE
  VASISTAS
  FINESTRA_TETTO
  // Bilico rettangolare (serie TOUR, 2026-07-26). Il bilico TONDO (TOUR-R,
  // p0554-0562) è un prodotto diverso e non è coperto.
  BILICO
}

enum MaterialType {
  LEGNO
  PVC
  ALLUMINIO
  LEGNO_ALLUMINIO
  PVC_ALLUMINIO
}

enum HingeSide {
  DESTRA
  SINISTRA
}

// Le 7 combinazioni (aria, interasse, battuta) degli schemi di montaggio ARTECH
// legno 2026 — vedi `src/server/kit/artech-geometrie.ts` (fonte di verità dei
// VALORI; qui solo l'enum DB, vincolato da `GEOMETRY_IDS` in `kit/types.ts`).
enum ArtechGeometry {
  A4_I85_B15
  A4_I9_B18
  A4_I13_B18
  A12_I9_B18
  A12_I9_B20
  A12_I13_B18
  A12_I13_B20
}

// SEDE_30 è accettata dallo schema zod ma rifiutata dai moduli regole finché
// manca l'incontro DSS 13x30 a listino (vedi kit/types.ts).
enum SeatConfig {
  STANDARD
  SEDE_30
}

/// Entrata maniglia. Due soli valori pubblicati: p0424 (422) etichetta la colonna
/// ENTRATA come `1) 7,5` e `2) 15`; la terza voce («Asta») è un'altra famiglia,
/// senza DSS né monoblocco martellina, e resta fuori perimetro.
/// E75 = entrata 7,5 (convenzione di ArtechGeometry, dove I85 = interasse 8,5).
enum Entrata {
  E75
  E15
}

enum OpeningDirection {
  TIRARE
  SPINGERE
}

model KitRequest {
  id            String @id @default(cuid())
  requestNumber String @unique @map("request_number")

  windowType WindowType   @map("window_type")
  widthMm    Int          @map("width_mm")
  heightMm   Int          @map("height_mm")
  material   MaterialType
  finish     String
  series     String

  // ── Geometria: SOLO serie ARTECH ─────────────────────────────────────────
  // Un discriminatore unico al posto dei quattro numerici. Le vecchie colonne
  // restano nullable come LEGACY: la garanzia che nessun modulo le legga è
  // `PersistedKitRequest` in `src/server/kit/from-request.ts`, che le ESCLUDE
  // deliberatamente dalla forma della riga usata per rigenerare — quindi non
  // c'è modo di leggerle. Servono solo a non perdere lo storico.
  //
  // NESSUN `@default` a livello DB su `seatConfig`: un default DB valorizzerebbe
  // TUTTE le righe pre-esistenti (comprese le TOUR, che non hanno sede) e
  // tradurrebbe in silenzio una riga legacy `seat_mm = 30` in `STANDARD`,
  // scavalcando `assertSeatConfigSupportata`. Il default sta nello schema zod
  // (`kit/types.ts`), dove è un default *dell'input*, e nel backfill della
  // migrazione, dove è *derivato* da `seat_mm`.
  geometry   ArtechGeometry?
  seatConfig SeatConfig?     @map("seat_config")

  /// SOLO serie ARTECH — NULL sulle righe TOUR (il bilico ha entrata 30 come
  /// proprietà costruttiva del kit, non come scelta). Nessun `@default` a
  /// livello DB, stesso criterio di `seatConfig`: un default DB valorizzerebbe
  /// anche le righe che non devono averlo. Il backfill è nella migrazione.
  entrata Entrata?

  /// Varianti componente scelte dall'agente (spec 2026-07-31). SOLO ARTECH:
  /// NULL sulle righe TOUR e su ogni riga creata prima di questa migrazione.
  /// NULL = «lo standard del programma», cioè i codici che il motore emette da
  /// sempre → NESSUN backfill, e nessuna riga esistente si muove. Nessun
  /// `@default` a livello DB, stesso criterio di `seatConfig`/`entrata`/
  /// `discountPercent`: un default DB valorizzerebbe anche le righe che non
  /// devono averlo.
  variants Json?

  /// Sconto applicato al cliente, in punti percentuali (42.50 = −42,5%).
  /// NULL = nessuno sconto: la distinta resta al lordo di listino, che è il
  /// comportamento di OGNI riga esistente prima del 2026-07-30 — per questo la
  /// migrazione non ha backfill, a differenza di `entrata`.
  ///
  /// Vive QUI e non solo su `Customer` di proposito: se stesse solo sul cliente,
  /// ritoccarne lo sconto cambierebbe in silenzio il totale di ogni distinta già
  /// mandata. È la stessa ragione per cui il ricalcolo è versionato
  /// (`supersededById`). Il cliente porta il default, la richiesta conserva il
  /// valore davvero applicato.
  ///
  /// Nessun `@default` a livello DB, stesso criterio di `seatConfig` ed
  /// `entrata`: un default DB valorizzerebbe anche le righe che non devono
  /// averlo.
  discountPercent Decimal? @map("discount_percent") @db.Decimal(5, 2)

  openingSide HingeSide?        @map("opening_side")
  openingDir  OpeningDirection? @map("opening_direction")

  /// LEGACY — non letto da alcun modulo dal 2026-07-29.
  airGapMm     Int? @map("air_gap_mm")
  /// LEGACY
  axisOffsetMm Int? @map("axis_offset_mm")
  /// LEGACY
  rebateMm     Int? @map("rebate_mm")
  /// LEGACY
  seatMm       Int? @map("seat_mm")

  /// Versione del motore che ha prodotto la distinta.
  engineVersion  String?     @map("engine_version")
  /// Ricalcolo versionato (Task 5): la riga VECCHIA punta alla nuova che la
  /// sostituisce. Il verso è quello del nome del campo — «superseded BY» — ed è
  /// quello che scrive il ricalcolo: `update(where: vecchia, { supersededById: nuova })`.
  /// Così la riga emessa al cliente resta intatta e sa dove sta la revisione.
  supersededById String?     @unique @map("superseded_by_id")
  /// Sulla riga vecchia: la versione che l'ha sostituita (più recente).
  supersededBy   KitRequest? @relation("KitRequestVersione", fields: [supersededById], references: [id])
  /// Sulla riga nuova: la versione che questa sostituisce (più vecchia).
  supersedes     KitRequest? @relation("KitRequestVersione")

  // ── Serie TOUR (bilico) ──────────────────────────────────────────────────
  // Schema di montaggio 1-5 del listino. Da solo implica listello, asse,
  // battuta, modello di cerniera e guarnizione: quei valori NON si persistono
  // (sarebbero una seconda fonte di verità), si derivano in codice. In
  // particolare l'asse dello schema 3 è 17,5 e non è un intero.
  tourSchema            Int?    @map("tour_schema")
  supplementaryClosures Boolean @default(false) @map("supplementary_closures")
  // Peso dell'anta in kg — FACOLTATIVO (nullable, nessun default): le due NB
  // dello schema vasistas p0418 (416) valgono solo se l'agente lo indica.
  sashWeightKg          Int?    @map("sash_weight_kg")

  notes         String? @db.Text
  customerNotes String? @map("customer_notes") @db.Text

  status       KitRequestStatus @default(DRAFT)
  generatedKit Json?            @map("generated_kit")

  totalComponents Int      @default(0) @map("total_components")
  totalPrice      Decimal? @map("total_price") @db.Decimal(12, 2)

  agentId String @map("agent_id")
  agent   User   @relation("KitRequestAgent", fields: [agentId], references: [id])

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id])

  components KitComponent[]

  pdfUrl         String?   @map("pdf_url")
  pdfGeneratedAt DateTime? @map("pdf_generated_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  generatedAt DateTime? @map("generated_at")

  @@index([requestNumber])
  @@index([agentId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([windowType, material, series])
  @@map("kit_requests")
}

model KitComponent {
  id String @id @default(cuid())

  kitRequestId String     @map("kit_request_id")
  kitRequest   KitRequest @relation(fields: [kitRequestId], references: [id], onDelete: Cascade)

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  componentCode String  @map("component_code")
  componentName String  @map("component_name")
  position      String?
  quantity      Int     @default(1)
  unitPrice     Decimal @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal @map("total_price") @db.Decimal(12, 2)

  ruleId          String? @map("rule_id")
  ruleDescription String? @map("rule_description") @db.Text
  isOptional      Boolean @default(false) @map("is_optional")
  isAlternative   Boolean @default(false) @map("is_alternative")

  sortOrder Int @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kitRequestId, componentCode, position])
  @@index([kitRequestId])
  @@index([productId])
  @@index([componentCode])
  @@index([sortOrder])
  @@map("kit_components")
}

model KitTemplate {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text

  windowType WindowType?   @map("window_type")
  material   MaterialType?
  series     String?

  rules Json

  categoryId String?          @map("category_id")
  category   ProductCategory? @relation(fields: [categoryId], references: [id])

  isActive Boolean @default(true) @map("is_active")
  priority Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([windowType, material, series])
  @@index([isActive])
  @@index([priority])
  @@map("kit_templates")
}

// ═══════════════════════════════════════════════════════════════
// 4. CUSTOMER (B2B)
// ═══════════════════════════════════════════════════════════════

model Customer {
  id          String  @id @default(cuid())
  companyName String  @map("company_name")
  vatNumber   String? @unique @map("vat_number")
  taxCode     String? @unique @map("tax_code")

  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  address  String?
  city     String?
  province String?
  zipCode  String? @map("zip_code")
  country  String  @default("IT")

  customerCode String?  @unique @map("customer_code")
  priceList    String?  @map("price_list")
  paymentTerms String?  @map("payment_terms")
  discount     Decimal? @db.Decimal(5, 2)

  /// Profilo serramento del cliente — SOLO serie ARTECH.
  ///
  /// Sono le due quote che NON cambiano da un ordine all'altro dello stesso
  /// cliente: la geometria (aria/interasse/battuta) e l'entrata della maniglia.
  /// Servono a non farle ri-scegliere a memoria fra 14 combinazioni a ogni
  /// richiesta, quando sbagliarle non produce alcun errore visibile — i codici
  /// della combinazione sbagliata esistono a listino e hanno un prezzo.
  ///
  /// NON precompilano il wizard: l'agente le applica con un clic esplicito
  /// («Usa il profilo»). Un valore preselezionato sarebbe lo stesso silenzio in
  /// un posto più visibile — è la decisione della #40, qui rispettata alla lettera.
  ///
  /// Il nome dice «kit», ma la cosa è del **serramento**, non del cliente: Fosca
  /// non *ha* una geometria, ha avuto quella negli infissi ordinati finora. È il
  /// motivo per cui il valore resta modificabile a ogni richiesta invece di
  /// essere imposto.
  ///
  /// NULL = nessun profilo dichiarato, che è lo stato di OGNI cliente prima di
  /// questa migrazione: nessun backfill, a differenza di `kit_requests.entrata`.
  ///
  /// Lo snapshot è altrove e già garantito: `kit.create` scrive geometria ed
  /// entrata sulla riga di `kit_requests`, quindi correggere un profilo domani
  /// non tocca una distinta di ieri. Stessa proprietà per cui `discountPercent`
  /// vive sulla richiesta e non solo sul cliente.
  kitGeometry ArtechGeometry? @map("kit_geometry")
  kitEntrata  Entrata?        @map("kit_entrata")

  kitRequests KitRequest[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyName])
  @@index([vatNumber])
  @@index([customerCode])
  @@map("customers")
}

// ═══════════════════════════════════════════════════════════════
// 5. CONVERSATION SYSTEM (AI Chat)
// ═══════════════════════════════════════════════════════════════

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

model Conversation {
  id     String             @id @default(cuid())
  title  String             @default("Nuova Conversazione")
  status ConversationStatus @default(ACTIVE)

  contextJson Json? @map("context_json")

  agentId String @map("agent_id")
  agent   User   @relation(fields: [agentId], references: [id])

  messages Message[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([agentId])
  @@index([status])
  @@index([createdAt])
  @@map("conversations")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum MessageStatus {
  PENDING
  SENT
  ERROR
  STREAMING
}

model Message {
  id String @id @default(cuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role        MessageRole
  content     String      @db.Text
  contentHtml String?     @map("content_html") @db.Text

  toolName   String? @map("tool_name")
  toolInput  Json?   @map("tool_input")
  toolOutput Json?   @map("tool_output")

  modelUsed  String? @map("model_used")
  tokensUsed Int?    @map("tokens_used")
  latencyMs  Int?    @map("latency_ms")

  referencedProductIds String[]  @map("referenced_product_ids")
  referencedProducts   Product[] @relation("ReferencedProducts")

  status       MessageStatus @default(SENT)
  errorMessage String?       @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
  @@index([toolName])
  @@map("messages")
}

// ═══════════════════════════════════════════════════════════════
// 6. ACTIVITY LOG
// ═══════════════════════════════════════════════════════════════

enum ActivityType {
  LOGIN
  LOGOUT
  CONVERSATION_CREATED
  CONVERSATION_MESSAGE
  KIT_REQUEST_CREATED
  KIT_GENERATED
  KIT_EXPORTED_PDF
  PRODUCT_SEARCHED
  CUSTOMER_VIEWED
  SETTINGS_CHANGED
  USER_CREATED
  USER_UPDATED
  IMPORT_EXECUTED
}

model ActivityLog {
  id String @id @default(cuid())

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  type        ActivityType
  description String       @db.Text
  metadata    Json?

  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent") @db.Text

  resourceType String? @map("resource_type")
  resourceId   String? @map("resource_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("activity_logs")
}

// ═══════════════════════════════════════════════════════════════
// 7. SETTINGS
// ═══════════════════════════════════════════════════════════════

enum SettingCategory {
  AI_PROVIDER
  API_KEYS
  COMPANY_INFO
  EMAIL
  RATE_LIMITS
  FEATURE_FLAGS
}

model Settings {
  id          String          @id @default(cuid())
  category    SettingCategory
  key         String
  value       Json
  description String?         @db.Text
  isEncrypted Boolean         @default(false) @map("is_encrypted")

  updatedBy String @map("updated_by")
  updater   User   @relation(fields: [updatedBy], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, key])
  @@index([category])
  @@map("settings")
}

// ═══════════════════════════════════════════════════════════════
// 8. SYNC LOG (external integrations)
// ═══════════════════════════════════════════════════════════════

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

model SyncLog {
  id       String     @id @default(cuid())
  syncType String     @map("sync_type")
  status   SyncStatus @default(PENDING)

  recordsProcessed Int @default(0) @map("records_processed")
  recordsInserted  Int @default(0) @map("records_inserted")
  recordsUpdated   Int @default(0) @map("records_updated")
  recordsFailed    Int @default(0) @map("records_failed")

  errorMessage String? @map("error_message") @db.Text
  errorDetails Json?   @map("error_details")

  startedAt   DateTime  @map("started_at")
  completedAt DateTime? @map("completed_at")
  durationMs  Int?      @map("duration_ms")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([syncType])
  @@index([status])
  @@index([createdAt])
  @@map("sync_logs")
}

// ═══════════════════════════════════════════════════════════════
// 10. REPARTO MANIGLIE — archivio pronta consegna
//
// Tabelle PROPRIE: il dominio maniglie non tocca `Product`. Verdetto
// /llm-council del 2026-08-03 (A′ — stesso repo, dominio affiancato): si
// condividono repo, deploy, un solo Better Auth e lo stesso database fisico;
// NON si condivide l'identità del prodotto. La migrazione multi-fornitore di
// `Product` (agbCode @unique, ProductImage.agbCode @id, 128 occorrenze in 22
// file) si farà alla marca #3, con quattro cataloghi sul tavolo a dirne la
// forma — non oggi, indovinandola su uno.
// ═══════════════════════════════════════════════════════════════

/// Un articolo a listino: ciò che è ORDINABILE. Sorgente: il listino xlsx.
model Article {
  id String @id @default(cuid())

  /// `COLOMBO` oggi. Le altre marche (HOPPE, OLIVARI, DND, GHIDINI…) arrivano
  /// qui, non in tabelle nuove: la divisione del reparto è per merce, non per
  /// fornitore.
  brand String

  /// Come scritto a listino, coi separatori: `0CD41R-CM`.
  code String

  /// Soli [A-Z0-9] maiuscoli: `0CD41RCM`. LA CHIAVE DI AGGANCIO fra le tre
  /// fonti, che scrivono lo stesso codice in tre modi. Zero collisioni
  /// verificate sui 3.456 codici del listino.
  codeNorm String @map("code_norm")

  /// Descrizione del listino (troncata a 35 caratteri alla fonte, e con refusi
  /// digitati a mano: `BOCCEHTTA`, `ROBOCINQUQ` — di qui il ramo trigram).
  name String

  /// Le due metà del prezzo, salvate separate perché il *temporary surcharge*
  /// del 3,5% è temporaneo per definizione: il giorno che sparisce serve sapere
  /// quale metà togliere. Il TOTALE è derivato e non si persiste mai (stessa
  /// regola di `KitRequest.totalPrice`).
  priceList Decimal  @map("price_list") @db.Decimal(12, 2)
  surcharge Decimal? @db.Decimal(12, 2)

  ean String?

  /// Strato FACOLTATIVO, arricchito dopo da uno script che legge il catalogo
  /// PDF. Una marca senza catalogo funziona lo stesso, con articoli senza foto;
  /// l'archivio non dipende dal catalogo per essere utile.
  catalogPage Int?    @map("catalog_page")
  /// CHIAVE su Vercel Blob **PRIVATO**, senza suffisso di formato:
  /// `maniglie/colombo/<archivio>/<nome-file>`. I due WebP sono `-320` (miniatura
  /// di riga) e `-900` (scheda), e i byte passano sempre da `/api/article-image`,
  /// dietro auth: sono foto di un fornitore, e `public/` è escluso perché il repo
  /// è pubblico. Mai byte in Postgres: le 7.082 foto AGB dentro il DB sono la
  /// causa unica dei tre limiti di piattaforma più caldi.
  ///
  /// La scrive `pnpm foto:colombo` (mappatura in `foto-archivio.ts`). NULL =
  /// nessuna foto, che per il 42% dei codici è la normalità — minuteria e
  /// accessoristica che nessun catalogo fotografa una per una.
  ///
  /// Il nome della colonna dice «url» ed è ereditato: rinominarlo costerebbe una
  /// migrazione per un fatto che questo commento già chiarisce.
  imageUrl String? @map("image_url")

  /// Data dell'ultimo import di listino che conteneva il codice. Esiste per il
  /// listino nuovo che sta arrivando: l'import fa `upsert`, quindi i codici che
  /// COLOMBO toglie NON verrebbero cancellati e resterebbero a schermo identici
  /// agli altri, senza che nulla dica che non sono più ordinabili — la stessa
  /// forma del difetto della disponibilità falsa. Con questa colonna «non più a
  /// listino» è una cosa che si vede.
  lastListingAt DateTime @map("last_listing_at")

  stockLines StockLine[]

  /// Ricerca: solo Postgres (tsvector + trigram). Niente embedding, niente RAG —
  /// i codici COLOMBO nello stesso indice semantico farebbero citare maniglie a
  /// domande sui serramenti, e peserebbero su Gemini, provider unico.
  searchVector Unsupported("tsvector")? @map("search_vector")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([brand, code])
  @@unique([brand, codeNorm])
  @@index([brand])
  @@map("articles")
}

/// Un caricamento della pronta consegna. NON una colonna booleana su Article:
/// (a) i 23 orfani sono fatti SENZA articolo, e una colonna li cancellerebbe;
/// (b) lo storico risponde a «cosa è sempre esaurito?», che non è retrofittabile;
/// (c) `Product.isAvailable` insegna cosa succede a un flag deciso dal programma.
model StockImport {
  id    String @id @default(cuid())
  brand String

  fileName     String   @map("file_name")
  importedAt   DateTime @default(now()) @map("imported_at")
  importedById String   @map("imported_by_id")
  importedBy   User     @relation(fields: [importedById], references: [id])

  rowCount     Int @map("row_count")
  matchedCount Int @map("matched_count")
  orphanCount  Int @map("orphan_count")

  /// Annullamento: l'import resta a DB e smette di valere, così il precedente
  /// torna in vigore. Si annulla SOLO l'ultimo — cancellare un import qualunque
  /// della storia sarebbe riscrivere il passato, la stessa ragione per cui nel
  /// kit una distinta emessa genera una versione invece di riscriversi.
  cancelledAt DateTime? @map("cancelled_at")

  lines StockLine[]

  @@index([brand, cancelledAt, importedAt])
  @@map("stock_imports")
}

/// Una riga del file di pronta consegna.
model StockLine {
  id       String      @id @default(cuid())
  importId String      @map("import_id")
  import   StockImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  /// Come scritto nel file: serve il giorno che una normalizzazione va rivista,
  /// ed è ciò che Andrea rilegge nel suo gestionale.
  rawCode  String @map("raw_code")
  codeNorm String @map("code_norm")

  /// `null` = ORFANO: codice a magazzino che il listino non conosce. Non è un
  /// ripiego — è ciò che li farà riagganciare DA SOLI quando arriverà il listino
  /// aggiornato, senza ricaricare a mano ogni pronta consegna passata.
  articleId String?  @map("article_id")
  article   Article? @relation(fields: [articleId], references: [id])

  @@index([importId])
  @@index([articleId])
  @@index([codeNorm])
  @@map("stock_lines")
}
